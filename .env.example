# --- Telegram (https://my.telegram.org/apps) ---
API_ID=
API_HASH=
PHONE_NUMBER=+15551234567
# Name used for the Telethon .session file stored under data/
SESSION_NAME=telegram_agent_session

# Comma-separated list of groups to monitor. Each entry can be a username
# (with or without @), an invite-link slug you've already joined, or a
# numeric chat ID (including the "-100..." supergroup form).
# Example: TELEGRAM_GROUPS=ai_jobs_india,@hackathons_hub,-1001234567890
TELEGRAM_GROUPS=

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=5
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_CONCURRENT_REQUESTS=3
GEMINI_TEMPERATURE=0.2

# --- Filtering ---
# Optional: comma-separated keywords. If set, only messages containing at
# least one keyword are sent to Gemini (saves API cost). Leave empty to
# send every message.
KEYWORDS=
# Messages shorter than this (after trimming) are skipped entirely.
MIN_MESSAGE_LENGTH=8

# --- Database ---
# SQLite by default. To use PostgreSQL instead, install asyncpg and set:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/telegram_agent
DATABASE_URL=sqlite+aiosqlite:///data/telegram_agent.db

# --- REST API ---
RUN_API=true
API_HOST=0.0.0.0
API_PORT=8000

# --- Daily summary ---
DAILY_SUMMARY_ENABLED=true
# Hour of day (0-23, UTC) at which to generate the daily summary.
DAILY_SUMMARY_HOUR=23

# --- Logging ---
LOG_LEVEL=INFO
